# Copy to .env for local runs, or set these in the host's environment.

# Coach's server (server/index.js)
# Studio's public address. Coach relays sign-in to Studio's API here.
STUDIO_ORIGIN=https://trainabilitystudio.com
# PORT=4800          # leave unset on GoDaddy Airo; the host injects it
# TRUST_PROXY=1      # how many proxies sit in front of Coach on the host

# Coach's page (read at build time)
# VITE_STUDIO_URL=https://trainabilitystudio.com/   # where "Open Studio" goes

# Local testing against Studio's throwaway fixture API (npm run fixture in
# TrainabilityWeb3, port 4700). This account exists only in
# TrainabilityWeb3/fixtures/app.sqlite and is gone after `npm run fixture -- --fresh`.
