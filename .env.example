# Copy to server/.env for local runs, or set these in the host's environment.

# Coach's server (server/index.js)
# Studio's public address. Coach relays sign-in to Studio's API here.
STUDIO_ORIGIN=https://www.trainabilitystudio.com
# PORT=4800          # leave unset on GoDaddy Airo; the host injects it
# TRUST_PROXY=1      # how many proxies sit in front of Coach on the host

# Billy (server/billy.js): the same names as in Studio's server/.env.
# Unset, Billy is not offered anywhere in Coach. A key of Coach's own, made in
# the Anthropic Console (console.anthropic.com → API keys), keeps Coach's use
# and cost apart from Studio's; Studio's key works too.
ANTHROPIC_API_KEY=
# Which model answers. Unset: claude-sonnet-5-5. claude-opus-5-5 is stronger
# and twice the price.
# ASSISTANT_MODEL=claude-sonnet-5-5
# ASSISTANT_TRACE=1  # logs each turn while debugging; leave off

# Coach's page (read at build time, from .env.local at the top of the repo, as in Studio)
# VITE_STUDIO_URL=https://trainabilitystudio.com/   # where "Open Studio" goes

# Local test account and settings: see server/.env (not committed).

# Coach's own database (server/db.js). On GoDaddy the host sets these for the
# app's own new database. Leave them unset on a Mac or in a cloud session, and
# Coach uses a SQLite file instead (server/coach.sqlite, or COACH_SQLITE_PATH).
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true        # if the database asks for TLS

# Where Coach saves files (server/durable-home.js), as Studio's BACKUP_DIR and
# MEDIA_DIR. Leave unset: on the host the app uses its Private Storage,
# /private/trainability-coach, kept across deploys, and the Primary Master can
# name another folder under Installation. Set, this wins and the screen says so.
# COACH_FILES_DIR=
